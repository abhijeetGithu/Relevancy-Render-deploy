# Copy to .env and adjust for deployment (optional — compose has defaults)

# Docker Hub / registry: your Docker Hub username (or org) — used in image names for build & push
# Example: SUITE_REGISTRY=johndoe   → images like johndoe/relevancy-suite-portal:latest
# Leave unset to tag as local/relevancy-suite-* (local use only; not pushed to Docker Hub)
# SUITE_REGISTRY=
# SUITE_TAG=latest

# Host ports (maps container → host)
PORTAL_HOST_PORT=8004
DATAQUERY_HOST_PORT=5051
LLM_COMPARATOR_HOST_PORT=8005
RELEVANCY_HOST_PORT=8006

# DataQuery Engine → LLM Comparator (inside Docker network; do not change unless you rename the service)
# LLM_COMPARATOR_URL=http://llm-comparator:8005

# Gunicorn (DataQuery_Engine)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=1200

# LLM Comparator (optional — for features that call OpenAI directly)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Web Scraper (Docker image sets CHROME_BIN; override only for custom Chrome/Chromium path)
# CHROME_BIN=/usr/bin/google-chrome-stable
