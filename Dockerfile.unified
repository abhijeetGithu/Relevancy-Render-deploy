# Unified Dockerfile for Search Relevancy Suite
# Combines Portal, DataQuery Engine, LLM Comparator, and Relevancy Script
# into a single application with Chrome for Selenium support.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CHROME_BIN=/usr/bin/google-chrome-stable

WORKDIR /app

# Install system deps: Chrome for Selenium, curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    gnupg \
    wget \
    && wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" \
       >> /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/google-chrome-stable /usr/local/bin/google-chrome

# Install Python dependencies
COPY requirements-unified.txt .
RUN pip install --no-cache-dir -r requirements-unified.txt

# Copy all application code
COPY portal ./portal
COPY DataQuery_Engine ./DataQuery_Engine
COPY LLM_Comparator ./LLM_Comparator
COPY relevancy-script ./relevancy-script
COPY app_unified.py .

# Create directories the DataQuery Engine expects
RUN mkdir -p /app/DataQuery_Engine/.temp_downloads \
             /app/DataQuery_Engine/query_outputs/generated_queries \
             /app/DataQuery_Engine/query_outputs/uploads

# Non-root user for security
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE ${PORT:-8000}

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT:-8000}/health || exit 1

CMD ["sh", "-c", "uvicorn app_unified:app --host 0.0.0.0 --port ${PORT:-8000}"]
